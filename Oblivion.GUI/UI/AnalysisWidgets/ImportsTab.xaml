<UserControl x:Class="Oblivion.GUI.UI.AnalysisWidgets.ImportsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d">

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="IMPORTED LIBRARIES" FontSize="13" FontWeight="Bold"
                   FontFamily="{StaticResource OblivionMonoFont}"
                   Foreground="{DynamicResource OblivionTextMuted}" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Background="{DynamicResource OblivionCard}"
                BorderBrush="{DynamicResource OblivionBorder}"
                BorderThickness="1" CornerRadius="6" ClipToBounds="True">

            <TreeView ItemsSource="{Binding ImportEntriesEnriched}"
                      Background="Transparent" BorderThickness="0"
                      Padding="8">
                <TreeView.Resources>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="Foreground" Value="{DynamicResource OblivionText}"/>
                        <Setter Property="IsExpanded" Value="True"/>
                        <Setter Property="Margin" Value="0,2"/>
                    </Style>
                </TreeView.Resources>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Functions}">
                        <!-- Module header -->
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <ui:SymbolIcon Symbol="Library24" FontSize="14"
                                           Foreground="{DynamicResource OblivionAccent}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ModuleName}" FontSize="13"
                                       FontFamily="{StaticResource OblivionMonoFont}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource OblivionAccent}"/>
                            <TextBlock FontSize="11" Margin="8,0,0,0"
                                       Foreground="{DynamicResource OblivionTextMuted}"
                                       VerticalAlignment="Center">
                                <Run Text="("/>
                                <Run Text="{Binding Functions.Count, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Function items with severity badge -->
                        <HierarchicalDataTemplate.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                               FontFamily="{StaticResource OblivionMonoFont}"
                                               Foreground="{DynamicResource OblivionTextMuted}"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding Description}"/>
                                    <!-- Severity badge — only visible for Medium/Dangerous -->
                                    <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="3"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Background" Value="{DynamicResource OblivionOrangeBg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Dangerous">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Background" Value="{DynamicResource OblivionRedBg}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="10" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Severity}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                                            <Setter Property="Foreground" Value="{DynamicResource OblivionOrange}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Dangerous">
                                                            <Setter Property="Foreground" Value="{DynamicResource OblivionRed}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </HierarchicalDataTemplate.ItemTemplate>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>
    </Grid>
</UserControl>
