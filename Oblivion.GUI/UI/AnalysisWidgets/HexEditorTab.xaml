<UserControl x:Class="Oblivion.GUI.UI.AnalysisWidgets.HexEditorTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:hex="clr-namespace:WpfHexaEditor;assembly=WPFHexaEditor"
             mc:Ignorable="d">

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="HEX EDITOR" FontSize="13" FontWeight="Bold"
                   FontFamily="{StaticResource OblivionMonoFont}"
                   Foreground="{DynamicResource OblivionTextMuted}" Margin="0,0,0,12"/>

        <!-- Save/Revert Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource OblivionCard}"
                BorderBrush="{DynamicResource OblivionBorder}"
                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Save" Appearance="Primary" Margin="0,0,8,0"
                           Padding="16,4" FontSize="12"
                           Click="OnSaveClick"/>
                <ui:Button Content="Save As..." Margin="0,0,8,0"
                           Padding="16,4" FontSize="12"
                           Click="OnSaveAsClick"/>
                <ui:Button Content="Revert" Margin="0,0,16,0"
                           Padding="16,4" FontSize="12"
                           Command="{Binding RevertFileCommand}"/>

                <Border Background="{DynamicResource OblivionBg}" CornerRadius="4"
                        Padding="8,4" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock FontSize="11" Foreground="{DynamicResource OblivionTextSecondary}">
                        <Run Text="Modified: "/>
                        <Run x:Name="ModifiedIndicator" Text="No"
                             Foreground="{DynamicResource OblivionGreen}"/>
                    </TextBlock>
                </Border>

                <TextBlock Text="{Binding EditStatus}" FontSize="11"
                           Foreground="{DynamicResource OblivionTextMuted}"
                           VerticalAlignment="Center"/>
            </WrapPanel>
        </Border>

        <!-- Go to / Find Toolbar -->
        <Border Grid.Row="2" Background="{DynamicResource OblivionCard}"
                BorderBrush="{DynamicResource OblivionBorder}"
                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Go to offset:" FontSize="12"
                           Foreground="{DynamicResource OblivionTextSecondary}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ui:TextBox Text="{Binding HexOffset, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="0x0" Width="140" FontSize="12"
                            FontFamily="{StaticResource OblivionMonoFont}"
                            Background="{DynamicResource OblivionBg}"
                            Foreground="{DynamicResource OblivionText}"
                            BorderBrush="{DynamicResource OblivionBorder}"/>
                <ui:Button Content="Go" Appearance="Primary" Margin="8,0,16,0"
                           Padding="16,4" FontSize="12"
                           Command="{Binding GoToOffsetCommand}"/>

                <TextBlock Text="Find hex:" FontSize="12"
                           Foreground="{DynamicResource OblivionTextSecondary}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ui:TextBox x:Name="SearchBox" PlaceholderText="4D 5A 90 00"
                            Width="180" FontSize="12"
                            FontFamily="{StaticResource OblivionMonoFont}"
                            Background="{DynamicResource OblivionBg}"
                            Foreground="{DynamicResource OblivionText}"
                            BorderBrush="{DynamicResource OblivionBorder}"/>
                <ui:Button Content="Find" Margin="8,0,4,0" Padding="12,4" FontSize="12"
                           Click="OnFindClick"/>
                <ui:Button Content="Next" Margin="4,0,0,0" Padding="12,4" FontSize="12"
                           Click="OnFindNextClick"/>
            </WrapPanel>
        </Border>

        <!-- Section legend -->
        <ItemsControl x:Name="SectionLegend" Grid.Row="3" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- Hex Editor -->
        <Border Grid.Row="4" Background="{DynamicResource OblivionBg}"
                BorderBrush="{DynamicResource OblivionBorder}"
                BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <hex:HexEditor x:Name="HexEditorControl"
                           ReadOnlyMode="False"
                           BytePerLine="16"
                           Foreground="{DynamicResource OblivionText}"
                           Background="{DynamicResource OblivionBg}"
                           FontFamily="{StaticResource OblivionMonoFont}"
                           FontSize="12"/>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="5" Background="{DynamicResource OblivionCard}"
                BorderBrush="{DynamicResource OblivionBorder}"
                BorderThickness="1,0,1,1" Padding="12,4" Margin="0,0,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="11" FontFamily="{StaticResource OblivionMonoFont}"
                           Foreground="{DynamicResource OblivionTextSecondary}">
                    <Run Text="Offset: "/>
                    <Run x:Name="CurrentOffsetText" Text="0x0"/>
                </TextBlock>
                <TextBlock FontSize="11" FontFamily="{StaticResource OblivionMonoFont}"
                           Foreground="{DynamicResource OblivionTextSecondary}" Margin="24,0,0,0">
                    <Run Text="Selection: "/>
                    <Run x:Name="SelectionLengthText" Text="0 bytes"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
