<UserControl x:Class="Oblivion.GUI.UI.AnalysisWidgets.FunctionsDbTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d">

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="WINAPI FUNCTIONS DATABASE" FontSize="13" FontWeight="Bold"
                   FontFamily="{StaticResource OblivionMonoFont}"
                   Foreground="{DynamicResource OblivionTextMuted}" Margin="0,0,0,12"/>

        <!-- Filter bar -->
        <Border Grid.Row="1" Background="{DynamicResource OblivionCard}"
                BorderBrush="{DynamicResource OblivionBorder}"
                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Search24" FontSize="14"
                               Foreground="{DynamicResource OblivionTextMuted}" Margin="0,0,8,0"/>
                <ui:TextBox Text="{Binding FunctionSearchText, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Search functions..."
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource OblivionText}" FontSize="12"
                            Width="250"/>

                <TextBlock Text="Severity:" FontSize="12"
                           Foreground="{DynamicResource OblivionTextSecondary}"
                           VerticalAlignment="Center" Margin="20,0,8,0"/>

                <ComboBox SelectedValue="{Binding SeverityFilter}"
                          SelectedValuePath="Content"
                          Background="{DynamicResource OblivionCard}"
                          Foreground="{DynamicResource OblivionText}"
                          FontSize="12" Width="120">
                    <ComboBoxItem Content="All" IsSelected="True"/>
                    <ComboBoxItem Content="Safe"/>
                    <ComboBoxItem Content="Medium"/>
                    <ComboBoxItem Content="Dangerous"/>
                </ComboBox>

                <TextBlock FontSize="11" Foreground="{DynamicResource OblivionTextMuted}"
                           VerticalAlignment="Center" Margin="16,0,0,0">
                    <Run Text="Showing "/>
                    <Run Text="{Binding FilteredFunctions.Count, Mode=OneWay}"/>
                    <Run Text=" of "/>
                    <Run Text="{Binding AllFunctions.Count, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Functions DataGrid -->
        <Border Grid.Row="2" Background="{DynamicResource OblivionBg}"
                BorderBrush="{DynamicResource OblivionBorder}"
                BorderThickness="1" CornerRadius="6" ClipToBounds="True">

            <ui:DataGrid ItemsSource="{Binding FilteredFunctions}"
                         Background="Transparent" BorderThickness="0"
                         AutoGenerateColumns="False" HeadersVisibility="Column"
                         GridLinesVisibility="Horizontal"
                         RowBackground="Transparent"
                         AlternatingRowBackground="{DynamicResource OblivionCard}"
                         Foreground="{DynamicResource OblivionText}"
                         IsReadOnly="True">

                <ui:DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource OblivionCard}"/>
                        <Setter Property="Foreground" Value="{DynamicResource OblivionTextSecondary}"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource OblivionBorder}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </ui:DataGrid.ColumnHeaderStyle>

                <ui:DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="{DynamicResource OblivionText}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ui:DataGrid.CellStyle>

                <ui:DataGrid.Columns>
                    <DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Cascadia Code, Consolas"/>
                                <Setter Property="Foreground" Value="{DynamicResource OblivionTextSecondary}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Function" Binding="{Binding Name}" Width="220">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Cascadia Code, Consolas"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{DynamicResource OblivionAccent}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>

                    <DataGridTemplateColumn Header="Severity" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource OblivionGreenBg}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                                    <Setter Property="Background" Value="{DynamicResource OblivionOrangeBg}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Dangerous">
                                                    <Setter Property="Background" Value="{DynamicResource OblivionRedBg}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Severity}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource OblivionGreen}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                                        <Setter Property="Foreground" Value="{DynamicResource OblivionOrange}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Dangerous">
                                                        <Setter Property="Foreground" Value="{DynamicResource OblivionRed}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </ui:DataGrid.Columns>
            </ui:DataGrid>
        </Border>
    </Grid>
</UserControl>
