<UserControl x:Class="Oblivion.GUI.UI.AnalysisWidgets.EntryPointTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="ENTRY POINT" FontSize="13" FontWeight="Bold"
                   FontFamily="{StaticResource OblivionMonoFont}"
                       Foreground="{DynamicResource OblivionTextMuted}" Margin="0,0,0,12"/>

            <!-- Current EP info -->
            <Border Grid.Row="1" Background="{DynamicResource OblivionCard}"
                    BorderBrush="{DynamicResource OblivionBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="20,16" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Current Entry Point" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource OblivionTextSecondary}" Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="{Binding EntryPoint}" FontSize="22"
                                   FontFamily="{StaticResource OblivionMonoFont}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource OblivionAccent}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Located in section: " FontSize="12"
                                   Foreground="{DynamicResource OblivionTextSecondary}"/>
                        <TextBlock Text="{Binding EntryPointSection}" FontSize="12"
                                   FontFamily="{StaticResource OblivionMonoFont}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource OblivionAccent}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Edit Entry Point -->
            <Border Grid.Row="2" Background="{DynamicResource OblivionCard}"
                    BorderBrush="{DynamicResource OblivionBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="20,16" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Edit Entry Point" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource OblivionTextSecondary}" Margin="0,0,0,12"/>

                    <TextBlock Text="Enter new RVA address (e.g. 0x1000):" FontSize="12"
                               Foreground="{DynamicResource OblivionTextMuted}" Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:TextBox Text="{Binding NewEntryPoint, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="0x1000"
                                    Width="200" FontSize="13"
                                    FontFamily="{StaticResource OblivionMonoFont}"
                                    Background="{DynamicResource OblivionBg}"
                                    Foreground="{DynamicResource OblivionText}"
                                    BorderBrush="{DynamicResource OblivionBorder}"/>
                        <ui:Button Content="Apply" Appearance="Primary" Margin="12,0,0,0"
                                   Padding="20,6" FontSize="12"
                                   Command="{Binding ChangeEntryPointCommand}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding EditStatus}" FontSize="11"
                               Foreground="{DynamicResource OblivionTextMuted}"/>
                </StackPanel>
            </Border>

            <!-- Inject Shellcode at EP -->
            <Border Grid.Row="3" Background="{DynamicResource OblivionCard}"
                    BorderBrush="{DynamicResource OblivionBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="20,16" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Inject Shellcode at Entry Point" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource OblivionTextSecondary}" Margin="0,0,0,12"/>

                    <TextBlock Text="Enter shellcode bytes (hex, space-separated):" FontSize="12"
                               Foreground="{DynamicResource OblivionTextMuted}" Margin="0,0,0,8"/>

                    <ui:TextBox Text="{Binding ShellcodeHex, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="90 90 CC C3"
                                FontSize="12"
                                FontFamily="{StaticResource OblivionMonoFont}"
                                Background="{DynamicResource OblivionBg}"
                                Foreground="{DynamicResource OblivionText}"
                                BorderBrush="{DynamicResource OblivionBorder}"
                                Margin="0,0,0,12"
                                MinHeight="40"/>

                    <TextBlock FontSize="11" Foreground="{DynamicResource OblivionTextMuted}" Margin="0,0,0,12"
                               TextWrapping="Wrap">
                        Creates a new .shell section with the shellcode, sets EP to it,
                        and adds a JMP back to the original entry point at the end.
                    </TextBlock>

                    <ui:Button Content="Inject as new section" Appearance="Caution"
                               Padding="20,6" FontSize="12"
                               Command="{Binding InjectShellcodeAtEpCommand}"/>
                </StackPanel>
            </Border>

            <!-- EP details with section mapping -->
            <Border Grid.Row="4" Background="{DynamicResource OblivionCard}"
                    BorderBrush="{DynamicResource OblivionBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Section Mapping" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource OblivionTextSecondary}" Margin="0,0,0,12"/>

                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource OblivionBg}"
                                        CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   FontFamily="{StaticResource OblivionMonoFont}" FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource OblivionAccent}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1" FontSize="11"
                                                   FontFamily="{StaticResource OblivionMonoFont}"
                                                   Foreground="{DynamicResource OblivionTextSecondary}"
                                                   VerticalAlignment="Center">
                                            <Run Text="0x"/><Run Text="{Binding VirtualAddress, StringFormat=X}"/>
                                            <Run Text=" — 0x"/><Run Text="{Binding VirtualSize, StringFormat=X}"/>
                                        </TextBlock>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <TextBlock Text="R" FontSize="10" FontWeight="Bold" Margin="3,0"
                                                       Foreground="{DynamicResource OblivionGreen}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsReadable}" Value="False">
                                                                <Setter Property="Opacity" Value="0.2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="W" FontSize="10" FontWeight="Bold" Margin="3,0"
                                                       Foreground="{DynamicResource OblivionRed}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWritable}" Value="False">
                                                                <Setter Property="Opacity" Value="0.2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="X" FontSize="10" FontWeight="Bold" Margin="3,0"
                                                       Foreground="{DynamicResource OblivionAccent}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExecutable}" Value="False">
                                                                <Setter Property="Opacity" Value="0.2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
