<UserControl x:Class="Oblivion.GUI.UI.AnalysisWidgets.SectionsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d">

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="PE SECTIONS" FontSize="13" FontWeight="Bold"
                   FontFamily="{StaticResource OblivionMonoFont}"
                   Foreground="{DynamicResource OblivionTextMuted}" Margin="0,0,0,12"/>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource OblivionCard}"
                BorderBrush="{DynamicResource OblivionBorder}"
                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Add Section" Appearance="Primary" Margin="0,0,8,0"
                           Padding="16,4" FontSize="12"
                           Click="OnAddSectionClick"/>
                <ui:Button Content="Edit Section" Margin="0,0,8,0"
                           Padding="16,4" FontSize="12"
                           Click="OnEditSectionClick"/>
                <ui:Button Content="View in Hex" Margin="0,0,8,0"
                           Padding="16,4" FontSize="12"
                           Click="OnViewInHexClick"/>
                <ui:Button Content="View in Disassembler" Margin="0,0,8,0"
                           Padding="16,4" FontSize="12"
                           Click="OnViewInDisasmClick"/>

                <TextBlock Text="{Binding EditStatus}" FontSize="11"
                           Foreground="{DynamicResource OblivionTextMuted}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource OblivionBg}"
                BorderBrush="{DynamicResource OblivionBorder}"
                BorderThickness="1" CornerRadius="6" ClipToBounds="True">

            <ui:DataGrid x:Name="SectionsGrid"
                         ItemsSource="{Binding Sections}"
                         Background="Transparent" BorderThickness="0"
                         AutoGenerateColumns="False" HeadersVisibility="Column"
                         GridLinesVisibility="Horizontal"
                         RowBackground="Transparent"
                         AlternatingRowBackground="{DynamicResource OblivionCard}"
                         Foreground="{DynamicResource OblivionText}"
                         IsReadOnly="True"
                         SelectionMode="Single">

                <ui:DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="View in Hex Editor" Click="OnViewInHexClick"/>
                        <MenuItem Header="View in Disassembler" Click="OnViewInDisasmClick"/>
                        <Separator/>
                        <MenuItem Header="Edit Characteristics..." Click="OnEditSectionClick"/>
                    </ContextMenu>
                </ui:DataGrid.ContextMenu>

                <ui:DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource OblivionCard}"/>
                        <Setter Property="Foreground" Value="{DynamicResource OblivionTextSecondary}"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource OblivionBorder}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </ui:DataGrid.ColumnHeaderStyle>

                <ui:DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="{DynamicResource OblivionText}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ui:DataGrid.CellStyle>

                <ui:DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource OblivionAccent}"/>
                                <Setter Property="FontFamily" Value="Cascadia Code, Consolas"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Virtual Address" Width="*">
                        <DataGridTextColumn.Binding>
                            <Binding Path="VirtualAddress" StringFormat="0x{0:X}"/>
                        </DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Cascadia Code, Consolas"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Virtual Size" Binding="{Binding VirtualSize}" Width="*"/>
                    <DataGridTextColumn Header="Raw Pointer" Width="*">
                        <DataGridTextColumn.Binding>
                            <Binding Path="RawDataPointer" StringFormat="0x{0:X}"/>
                        </DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Cascadia Code, Consolas"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Raw Size" Binding="{Binding RawDataSize}" Width="*"/>
                    <DataGridTemplateColumn Header="Entropy" Width="90" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                    <Ellipse Width="7" Height="7" Margin="0,0,5,0"
                                             Fill="{Binding Entropy, Converter={StaticResource EntropyToBrushConverter}}"/>
                                    <TextBlock Text="{Binding Entropy, StringFormat=F2}"
                                               FontFamily="{StaticResource OblivionMonoFont}" FontSize="12"
                                               Foreground="{Binding Entropy, Converter={StaticResource EntropyToBrushConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Characteristics" Width="*">
                        <DataGridTextColumn.Binding>
                            <Binding Path="Characteristics" StringFormat="0x{0:X8}"/>
                        </DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Cascadia Code, Consolas"/>
                                <Setter Property="Foreground" Value="{DynamicResource OblivionTextSecondary}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Access" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{Binding IsReadable, Converter={StaticResource BoolToPermissionBrushConverter}, ConverterParameter='R'}"
                                            CornerRadius="4" Width="22" Height="22" Margin="2,0">
                                        <TextBlock Text="R" FontSize="10" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReadable}" Value="False">
                                                            <Setter Property="Opacity" Value="0.2"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource OblivionTextMuted}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <Border Background="{Binding IsWritable, Converter={StaticResource BoolToPermissionBrushConverter}, ConverterParameter='W'}"
                                            CornerRadius="4" Width="22" Height="22" Margin="2,0">
                                        <TextBlock Text="W" FontSize="10" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWritable}" Value="False">
                                                            <Setter Property="Opacity" Value="0.2"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource OblivionTextMuted}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <Border Background="{Binding IsExecutable, Converter={StaticResource BoolToPermissionBrushConverter}, ConverterParameter='X'}"
                                            CornerRadius="4" Width="22" Height="22" Margin="2,0">
                                        <TextBlock Text="X" FontSize="10" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExecutable}" Value="False">
                                                            <Setter Property="Opacity" Value="0.2"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource OblivionTextMuted}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </ui:DataGrid.Columns>
            </ui:DataGrid>
        </Border>
    </Grid>
</UserControl>
