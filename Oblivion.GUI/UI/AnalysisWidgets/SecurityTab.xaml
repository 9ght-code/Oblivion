<UserControl x:Class="Oblivion.GUI.UI.AnalysisWidgets.SecurityTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:Oblivion.GUI.MVVM.Model"
             mc:Ignorable="d">

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="SECURITY CHARACTERISTICS" FontSize="13" FontWeight="Bold"
                   FontFamily="{StaticResource OblivionMonoFont}"
                   Foreground="{DynamicResource OblivionTextMuted}" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" Text="PE security mitigations detected from DllCharacteristics flags"
                   FontSize="12" Foreground="{DynamicResource OblivionTextMuted}" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="2">
            <!-- Security flags -->
            <ItemsControl ItemsSource="{Binding SecurityFlags}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:SecurityFlag}">
                        <Border Background="{DynamicResource OblivionCard}"
                                BorderBrush="{DynamicResource OblivionBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Margin="0,0,16,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource OblivionGreenBg}"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsEnabled}" Value="False"/>
                                                        <Condition Binding="{Binding IsWarning}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="{DynamicResource OblivionRedBg}"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsEnabled}" Value="False"/>
                                                        <Condition Binding="{Binding IsWarning}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="{DynamicResource OblivionOrangeBg}"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Foreground" Value="{DynamicResource OblivionGreen}"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsEnabled}" Value="False"/>
                                                            <Condition Binding="{Binding IsWarning}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="{DynamicResource OblivionRed}"/>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsEnabled}" Value="False"/>
                                                            <Condition Binding="{Binding IsWarning}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="{DynamicResource OblivionOrange}"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13"
                                               FontWeight="SemiBold" Foreground="{DynamicResource OblivionText}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               FontFamily="{StaticResource OblivionMonoFont}"
                                               Foreground="{DynamicResource OblivionTextMuted}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Enabled"/>
                                            <Setter Property="Foreground" Value="{DynamicResource OblivionGreen}"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsEnabled}" Value="False"/>
                                                        <Condition Binding="{Binding IsWarning}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text" Value="Disabled"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource OblivionRed}"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsEnabled}" Value="False"/>
                                                        <Condition Binding="{Binding IsWarning}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text" Value="Disabled"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource OblivionOrange}"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Dangerous Imports cross-reference -->
            <Border Background="{DynamicResource OblivionCard}"
                    BorderBrush="{DynamicResource OblivionBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:SymbolIcon Symbol="Warning24" FontSize="14"
                                       Foreground="{DynamicResource OblivionRed}" Margin="0,0,8,0"/>
                        <TextBlock Text="Dangerous Imports" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OblivionText}"/>
                        <Border Background="{DynamicResource OblivionRedBg}" CornerRadius="3"
                                Margin="8,0,0,0" Padding="5,1">
                            <TextBlock Text="{Binding DangerousImportedFunctions.Count}"
                                       Foreground="{DynamicResource OblivionRed}" FontSize="10"/>
                        </Border>
                    </StackPanel>

                    <!-- Empty state -->
                    <TextBlock Text="No dangerous or suspicious imports detected."
                               FontSize="12" Foreground="{DynamicResource OblivionTextMuted}"
                               Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DangerousImportedFunctions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Dangerous functions list -->
                    <ItemsControl ItemsSource="{Binding DangerousImportedFunctions}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DangerousImportedFunctions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4" ToolTip="{Binding Description}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="5,1" CornerRadius="3" Margin="0,0,8,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Dangerous">
                                                        <Setter Property="Background" Value="{DynamicResource OblivionRedBg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                                        <Setter Property="Background" Value="{DynamicResource OblivionOrangeBg}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Dangerous">
                                                            <Setter Property="Foreground" Value="{DynamicResource OblivionRed}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                                            <Setter Property="Foreground" Value="{DynamicResource OblivionOrange}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Grid.Column="1" FontSize="12" FontFamily="{StaticResource OblivionMonoFont}"
                                               Foreground="{DynamicResource OblivionTextMuted}" Margin="0,0,6,0">
                                        <Run Text="{Binding Module}"/><Run Text="!"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12"
                                               FontFamily="{StaticResource OblivionMonoFont}"
                                               Foreground="{DynamicResource OblivionTextMuted}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- DllCharacteristics raw value -->
            <Border Background="{DynamicResource OblivionCard}"
                    BorderBrush="{DynamicResource OblivionBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Raw DllCharacteristics: " FontSize="12"
                               Foreground="{DynamicResource OblivionTextSecondary}"/>
                    <TextBlock Text="{Binding DllCharacteristics}" FontSize="12"
                               FontFamily="{StaticResource OblivionMonoFont}"
                               Foreground="{DynamicResource OblivionAccent}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
