<UserControl x:Class="Oblivion.GUI.UI.AnalysisWidgets.DisassemblerTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d">

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="DISASSEMBLER" FontSize="13" FontWeight="Bold"
                   FontFamily="{StaticResource OblivionMonoFont}"
                   Foreground="{DynamicResource OblivionTextMuted}" Margin="0,0,0,12"/>

        <!-- Toolbar: Go to address + Patch actions -->
        <Border Grid.Row="1" Background="{DynamicResource OblivionCard}"
                BorderBrush="{DynamicResource OblivionBorder}"
                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Go to address:" FontSize="12"
                           Foreground="{DynamicResource OblivionTextSecondary}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ui:TextBox Text="{Binding DisasmGoToAddress, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="0x1000 or RVA"
                            Width="180" FontSize="12"
                            FontFamily="{StaticResource OblivionMonoFont}"
                            Background="{DynamicResource OblivionBg}"
                            Foreground="{DynamicResource OblivionText}"
                            BorderBrush="{DynamicResource OblivionBorder}"/>
                <ui:Button Content="Disassemble" Appearance="Primary" Margin="8,0,16,0"
                           Padding="16,4" FontSize="12"
                           Command="{Binding DisassembleFromAddressCommand}"/>

                <Border Width="1" Height="20" Background="{DynamicResource OblivionBorder}" Margin="0,0,16,0"/>

                <ui:Button Content="NOP selected" Margin="0,0,8,0"
                           Padding="12,4" FontSize="12"
                           Click="OnNopSelectedClick"/>
                <ui:Button Content="Patch bytes..." Margin="0,0,8,0"
                           Padding="12,4" FontSize="12"
                           Click="OnPatchBytesClick"/>
                <ui:Button Content="Save" Margin="0,0,0,0"
                           Padding="12,4" FontSize="12"
                           Command="{Binding SaveFileCommand}"/>
            </WrapPanel>
        </Border>

        <!-- Color legend + status -->
        <Border Grid.Row="2" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2"
                               Fill="{DynamicResource OblivionAccent}" Margin="0,0,4,0"/>
                    <TextBlock Text="call" FontSize="11"
                               Foreground="{DynamicResource OblivionTextMuted}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2"
                               Fill="{DynamicResource OblivionOrange}" Margin="0,0,4,0"/>
                    <TextBlock Text="jmp" FontSize="11"
                               Foreground="{DynamicResource OblivionTextMuted}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2"
                               Fill="{DynamicResource OblivionRed}" Margin="0,0,4,0"/>
                    <TextBlock Text="ret" FontSize="11"
                               Foreground="{DynamicResource OblivionTextMuted}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2"
                               Fill="{DynamicResource OblivionTextMuted}" Margin="0,0,4,0"/>
                    <TextBlock Text="nop" FontSize="11"
                               Foreground="{DynamicResource OblivionTextMuted}"/>
                </StackPanel>

                <TextBlock Text="{Binding DisasmStatus}" FontSize="11"
                           Foreground="{DynamicResource OblivionTextMuted}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Patch bytes inline -->
        <Border Grid.Row="3" Background="{DynamicResource OblivionCard}"
                BorderBrush="{DynamicResource OblivionBorder}"
                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                x:Name="PatchPanel" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="PatchTargetLabel" FontSize="12"
                           Foreground="{DynamicResource OblivionTextSecondary}" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox x:Name="PatchBytesBox"
                                PlaceholderText="90 90 90"
                                Width="300" FontSize="12"
                                FontFamily="{StaticResource OblivionMonoFont}"
                                Background="{DynamicResource OblivionBg}"
                                Foreground="{DynamicResource OblivionText}"/>
                    <ui:Button Content="Patch" Appearance="Primary" Margin="8,0,4,0"
                               Padding="16,4" FontSize="12"
                               Click="OnApplyPatchClick"/>
                    <ui:Button Content="Cancel" Margin="4,0,0,0"
                               Padding="12,4" FontSize="12"
                               Click="OnCancelPatchClick"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Disassembly list -->
        <Border Grid.Row="4" Background="{DynamicResource OblivionBg}"
                BorderBrush="{DynamicResource OblivionBorder}"
                BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <ListView x:Name="DisasmListView"
                      ItemsSource="{Binding DisassembledInstructions}"
                      Background="Transparent" BorderThickness="0"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      FontFamily="{StaticResource OblivionMonoFont}" FontSize="12"
                      SelectionMode="Single">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="NOP this instruction" Click="OnNopContextClick"/>
                        <MenuItem Header="Patch bytes..." Click="OnPatchContextClick"/>
                        <Separator/>
                        <MenuItem Header="View in Hex" Click="OnViewInHexContextClick"/>
                        <MenuItem Header="Copy address" Click="OnCopyAddressClick"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Bd" Background="Transparent" Padding="16,2,16,2">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource OblivionCard}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource OblivionCard}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Address -->
                            <TextBlock Grid.Column="0" Text="{Binding Address}"
                                       Foreground="{DynamicResource OblivionTextMuted}"
                                       FontSize="12"/>

                            <!-- Bytes -->
                            <TextBlock Grid.Column="1" Text="{Binding Bytes}"
                                       Foreground="{DynamicResource OblivionTextSecondary}"
                                       FontSize="12" Margin="8,0,0,0"/>

                            <!-- Instruction (mnemonic + operands) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Mnemonic}" FontSize="12" FontWeight="Medium"
                                           Foreground="{Binding Category, Converter={StaticResource CategoryToBrush}}"
                                           MinWidth="60"/>
                                <TextBlock Text="{Binding Operands}" FontSize="12"
                                           Foreground="{DynamicResource OblivionText}"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Assembler Panel -->
        <Border Grid.Row="5" Background="{DynamicResource OblivionCard}"
                BorderBrush="{DynamicResource OblivionBorder}"
                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="Assembler" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource OblivionTextSecondary}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox Text="{Binding AssembleInput, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="nop / ret / mov rax, rcx / hex bytes"
                                Width="300" FontSize="12"
                                FontFamily="{StaticResource OblivionMonoFont}"
                                Background="{DynamicResource OblivionBg}"
                                Foreground="{DynamicResource OblivionText}"/>
                    <TextBlock Text="at" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource OblivionTextSecondary}" Margin="8,0,8,0"/>
                    <ui:TextBox Text="{Binding AssembleTargetAddress, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="0x401000"
                                Width="140" FontSize="12"
                                FontFamily="{StaticResource OblivionMonoFont}"
                                Background="{DynamicResource OblivionBg}"
                                Foreground="{DynamicResource OblivionText}"/>
                    <ui:Button Content="Assemble &amp; Patch" Appearance="Primary" Margin="8,0,0,0"
                               Padding="16,4" FontSize="12"
                               Command="{Binding AssembleAndPatchCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding EditStatus}" FontSize="11"
                           Foreground="{DynamicResource OblivionTextMuted}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
