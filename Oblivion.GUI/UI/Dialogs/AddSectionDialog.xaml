<Window x:Class="Oblivion.GUI.UI.Dialogs.AddSectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Add Section" Height="420" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="420" MinWidth="450"
        Background="{DynamicResource OblivionBg}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ADD NEW SECTION" FontSize="13" FontWeight="Bold"
                   FontFamily="{StaticResource OblivionMonoFont}"
                   Foreground="{DynamicResource OblivionAccent}" Margin="0,0,0,16"/>

        <!-- Section Name -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Section Name (max 8 chars):" FontSize="12"
                       Foreground="{DynamicResource OblivionTextSecondary}" Margin="0,0,0,4"/>
            <ui:TextBox x:Name="SectionNameBox" PlaceholderText=".obli"
                        MaxLength="8" FontSize="12"
                        FontFamily="{StaticResource OblivionMonoFont}"
                        Background="{DynamicResource OblivionCard}"
                        Foreground="{DynamicResource OblivionText}"/>
        </StackPanel>

        <!-- Section Data (hex) -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Section Data (hex bytes):" FontSize="12"
                           Foreground="{DynamicResource OblivionTextSecondary}"/>
                <Button Content="Load from file..." FontSize="11" Margin="12,0,0,0"
                        Click="OnLoadFromFile" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource OblivionAccent}" Cursor="Hand"/>
            </StackPanel>
            <ui:TextBox x:Name="SectionDataBox" PlaceholderText="CC CC CC CC"
                        FontSize="12" MinHeight="60"
                        FontFamily="{StaticResource OblivionMonoFont}"
                        Background="{DynamicResource OblivionCard}"
                        Foreground="{DynamicResource OblivionText}"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Characteristics -->
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="Characteristics:" FontSize="12"
                       Foreground="{DynamicResource OblivionTextSecondary}" Margin="0,0,0,8"/>
            <WrapPanel Orientation="Horizontal">
                <CheckBox x:Name="ChkRead" Content="Read" IsChecked="True" Margin="0,0,16,0"
                          Foreground="{DynamicResource OblivionText}"/>
                <CheckBox x:Name="ChkWrite" Content="Write" Margin="0,0,16,0"
                          Foreground="{DynamicResource OblivionText}"/>
                <CheckBox x:Name="ChkExecute" Content="Execute" IsChecked="True" Margin="0,0,16,0"
                          Foreground="{DynamicResource OblivionText}"/>
                <CheckBox x:Name="ChkCode" Content="Code" IsChecked="True" Margin="0,0,16,0"
                          Foreground="{DynamicResource OblivionText}"/>
                <CheckBox x:Name="ChkInitData" Content="Initialized Data" Margin="0,0,16,0"
                          Foreground="{DynamicResource OblivionText}"/>
            </WrapPanel>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="Cancel" Margin="0,0,8,0" Padding="20,6"
                       Click="OnCancel"/>
            <ui:Button Content="Add Section" Appearance="Primary" Padding="20,6"
                       Click="OnConfirm"/>
        </StackPanel>
    </Grid>
</Window>
