<Window x:Class="Oblivion.GUI.UI.Dialogs.ThemeSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Theme Settings"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource OblivionBg}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="THEME SETTINGS"
                   FontSize="14" FontWeight="Bold"
                   FontFamily="{StaticResource OblivionMonoFont}"
                   Foreground="{DynamicResource OblivionAccent}"
                   Margin="0,0,0,16"/>

        <!-- Preset selector -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Preset:"
                       Foreground="{DynamicResource OblivionTextSecondary}"
                       VerticalAlignment="Center" Margin="0,0,12,0"
                       FontSize="13"/>

            <ComboBox x:Name="PresetComboBox" Grid.Column="1"
                      SelectionChanged="PresetComboBox_SelectionChanged"
                      Background="{DynamicResource OblivionCard}"
                      Foreground="{DynamicResource OblivionText}"
                      FontSize="13"/>
        </Grid>

        <!-- Color editors -->
        <ScrollViewer Grid.Row="2"
                      MaxHeight="420"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,0,0,16">
            <StackPanel x:Name="ColorEditorsPanel" />
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <ui:Button x:Name="ResetButton" Content="Reset"
                       Appearance="Secondary"
                       Click="ResetButton_Click"
                       Padding="16,8" Margin="0,0,8,0"
                       FontSize="13"/>
            <ui:Button x:Name="ApplyButton" Content="Apply"
                       Appearance="Primary"
                       Click="ApplyButton_Click"
                       Padding="16,8"
                       FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
