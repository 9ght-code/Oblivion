<ui:FluentWindow x:Class="Oblivion.GUI.UI.Windows.AnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:widgets="clr-namespace:Oblivion.GUI.UI.AnalysisWidgets"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        mc:Ignorable="d"
        Height="750" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{DynamicResource OblivionBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" ShowMaximize="True" ShowMinimize="True" Panel.ZIndex="99">
            <ui:TitleBar.Header>
                <TextBlock FontSize="12" Foreground="{DynamicResource OblivionTextSecondary}"
                           VerticalAlignment="Center" Margin="8,0">
                    <Run Text="Analysis — "/>
                    <Run Text="{Binding FileName, Mode=OneWay}"/>
                </TextBlock>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- File Header Bar -->
        <Border Grid.Row="1" Background="{DynamicResource OblivionCard}"
                BorderBrush="{DynamicResource OblivionBorder}"
                BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- File icon -->
                <Border Grid.Column="0" Background="{DynamicResource OblivionBg}"
                        CornerRadius="8" Width="44" Height="44" Margin="0,0,16,0">
                    <ui:SymbolIcon Symbol="Document24" FontSize="22"
                                   Foreground="{DynamicResource OblivionAccent}"/>
                </Border>

                <!-- File info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding FileName}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OblivionText}" Margin="0,0,16,0"/>

                        <!-- Architecture badge -->
                        <Border Background="{DynamicResource OblivionBg}" CornerRadius="4"
                                Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Architecture}" FontSize="11"
                                       FontFamily="{StaticResource OblivionMonoFont}"
                                       Foreground="{DynamicResource OblivionAccent}"/>
                        </Border>

                        <!-- File size badge -->
                        <Border Background="{DynamicResource OblivionBg}" CornerRadius="4"
                                Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock FontSize="11" Foreground="{DynamicResource OblivionTextSecondary}">
                                <Run Text="Size: "/><Run Text="{Binding FileSize, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>

                        <!-- Entry point badge -->
                        <Border Background="{DynamicResource OblivionBg}" CornerRadius="4"
                                Padding="8,2" VerticalAlignment="Center">
                            <TextBlock FontSize="11" FontFamily="{StaticResource OblivionMonoFont}"
                                       Foreground="{DynamicResource OblivionAccent}">
                                <Run Text="EP: " Foreground="{DynamicResource OblivionTextSecondary}"/>
                                <Run Text="{Binding EntryPoint, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- Hash -->
                    <TextBlock FontSize="11" FontFamily="{StaticResource OblivionMonoFont}" Margin="0,4,0,0"
                               Foreground="{DynamicResource OblivionTextMuted}">
                        <Run Text="SHA256: "/><Run Text="{Binding Hash, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading overlay -->
        <Border Grid.Row="2" Panel.ZIndex="10"
                Background="{DynamicResource OblivionBg}"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="Loading analysis..." FontSize="13" Margin="0,12,0,0"
                           Foreground="{DynamicResource OblivionTextSecondary}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- TabControl with tabs -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0"
                    Padding="0"
                    SelectedIndex="{Binding ActiveTabIndex, Mode=TwoWay}">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource OblivionTextSecondary}"/>
                    <Setter Property="Padding" Value="14,8"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="Transparent"
                                        Padding="{TemplateBinding Padding}"
                                        BorderThickness="0,0,0,2"
                                        BorderBrush="Transparent"
                                        Cursor="Hand">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="BorderBrush"
                                                Value="{DynamicResource OblivionAccent}"/>
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource OblivionText}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background"
                                                Value="{DynamicResource OblivionCard}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Overview">
                <widgets:OverviewTab DataContext="{Binding}"/>
            </TabItem>
            <TabItem Header="Sections">
                <widgets:SectionsTab DataContext="{Binding}"/>
            </TabItem>
            <TabItem Header="Hex Editor">
                <widgets:HexEditorTab DataContext="{Binding}"/>
            </TabItem>
            <TabItem Header="Imports">
                <widgets:ImportsTab DataContext="{Binding}"/>
            </TabItem>
            <TabItem Header="Entry Point">
                <widgets:EntryPointTab DataContext="{Binding}"/>
            </TabItem>
            <TabItem Header="Disassembler">
                <widgets:DisassemblerTab DataContext="{Binding}"/>
            </TabItem>
            <TabItem Header="Strings">
                <widgets:StringsTab DataContext="{Binding StringsTab}"/>
            </TabItem>
            <TabItem Header="Security">
                <widgets:SecurityTab DataContext="{Binding}"/>
            </TabItem>
            <TabItem Header="Functions DB">
                <widgets:FunctionsDbTab DataContext="{Binding FunctionsDbTab}"/>
            </TabItem>
            <TabItem Header="Shellcode">
                <widgets:ShellcodeTab DataContext="{Binding}"/>
            </TabItem>
            <TabItem Header="Tools">
                <widgets:ToolsTab DataContext="{Binding ToolsTab}"/>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
