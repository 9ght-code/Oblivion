<UserControl x:Class="Oblivion.GUI.Widgets.Entropy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Oblivion.GUI.Widgets"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Style="{StaticResource FadeInOnLoad}">
        <Border Style="{StaticResource CyberpunkCard}">
            <StackPanel>
                <TextBlock Text="SECTION LAYOUT"
                           Foreground="{DynamicResource OblivionTextMuted}"
                           FontWeight="SemiBold" FontSize="11"
                           FontFamily="{StaticResource OblivionMonoFont}"
                           Margin="0,0,0,12"/>
                <!-- Dynamic section bar -->
                <Border CornerRadius="6" ClipToBounds="True"
                        BorderBrush="{DynamicResource OblivionBorder}" BorderThickness="1">
                    <Grid x:Name="SectionBar" Height="22"/>
                </Border>
                <!-- Dynamic legend -->
                <WrapPanel x:Name="SectionLegend" Orientation="Horizontal" Margin="0,10,0,0"/>

                <!-- Per-section entropy -->
                <TextBlock Text="SECTION ENTROPY"
                           Foreground="{DynamicResource OblivionTextMuted}"
                           FontWeight="SemiBold" FontSize="11"
                           FontFamily="{StaticResource OblivionMonoFont}"
                           Margin="0,16,0,8"/>
                <StackPanel x:Name="EntropyBars"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
