<UserControl x:Class="Oblivion.GUI.Widgets.HealthCheckWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:Oblivion.GUI.MVVM.Model"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600">

    <StackPanel Margin="0,0,0,16" Style="{StaticResource FadeInOnLoad}">
        <TextBlock Text="HEALTH CHECK" FontSize="11" FontWeight="SemiBold"
                   FontFamily="{StaticResource OblivionMonoFont}"
                   Foreground="{DynamicResource OblivionTextMuted}" Margin="0,0,0,8"/>

        <!-- Score + Entropy cards -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Overall Score card -->
            <Border Style="{StaticResource CyberpunkCard}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="24" Margin="0,0,12,0"
                                   Foreground="{Binding SelectedFile.HealthStatus, Converter={StaticResource HealthStatusToBrushConverter}}">
                        <ui:SymbolIcon.Effect>
                            <DropShadowEffect Color="#00ff88" BlurRadius="10"
                                              ShadowDepth="0" Opacity="0.3"/>
                        </ui:SymbolIcon.Effect>
                    </ui:SymbolIcon>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="OVERALL SCORE" Foreground="{DynamicResource OblivionTextMuted}"
                                   FontSize="9" FontFamily="{StaticResource OblivionMonoFont}"
                                   Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding SelectedFile.HealthStatus}" FontWeight="Bold" FontSize="15"
                                   FontFamily="{StaticResource OblivionMonoFont}"
                                   Foreground="{Binding SelectedFile.HealthStatus, Converter={StaticResource HealthStatusToBrushConverter}}"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource OblivionTextMuted}" Margin="0,2,0,0"
                                   FontFamily="{StaticResource OblivionMonoFont}">
                            <Run Text="{Binding SelectedFile.AnomalyCount, Mode=OneWay}"/>
                            <Run Text="anomalies"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Entropy card -->
            <Border Grid.Column="2" Style="{StaticResource CyberpunkCard}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="ENTROPY" Foreground="{DynamicResource OblivionTextMuted}"
                               FontSize="9" FontFamily="{StaticResource OblivionMonoFont}"
                               Margin="0,0,0,3"/>
                    <TextBlock FontWeight="Bold" FontSize="15" Margin="0,0,0,4"
                               FontFamily="{StaticResource OblivionMonoFont}"
                               Foreground="{Binding SelectedFile.OverallEntropy, Converter={StaticResource EntropyToColorConverter}}">
                        <Run Text="{Binding SelectedFile.OverallEntropy, StringFormat='{}{0:F2}', Mode=OneWay}"/>
                        <Run Text="bits/byte" FontWeight="Normal" FontSize="10" Foreground="{DynamicResource OblivionTextMuted}"/>
                    </TextBlock>
                    <Grid>
                        <ProgressBar Minimum="0" Maximum="8" Value="{Binding SelectedFile.OverallEntropy, Mode=OneWay}"
                                     Height="6" Background="{DynamicResource OblivionBorder}"
                                     Foreground="{Binding SelectedFile.OverallEntropy, Converter={StaticResource EntropyToColorConverter}}"/>
                    </Grid>
                    <TextBlock FontSize="10" Foreground="{DynamicResource OblivionTextMuted}" Margin="0,3,0,0"
                               FontFamily="{StaticResource OblivionMonoFont}"
                               HorizontalAlignment="Right">
                        <Run Text="{Binding SelectedFile.OverallEntropy, StringFormat='{}{0:P0}', Mode=OneWay, ConverterParameter=8}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Installer detection -->
        <Border Padding="14,10" Margin="0,0,0,8">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CyberpunkCard}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedFile.DetectedInstaller}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border CornerRadius="4" Padding="8,4" Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource OblivionTealBg}"
                        BorderBrush="{DynamicResource OblivionTeal}" BorderThickness="1">
                    <TextBlock Text="INSTALLER" FontSize="10" FontWeight="Bold"
                               FontFamily="{StaticResource OblivionMonoFont}"
                               Foreground="{DynamicResource OblivionTeal}"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="13" FontWeight="SemiBold"
                               FontFamily="{StaticResource OblivionMonoFont}"
                               Foreground="{DynamicResource OblivionText}"
                               Text="{Binding SelectedFile.DetectedInstaller}"/>
                    <TextBlock Text="Installer framework detected"
                               FontSize="10" Foreground="{DynamicResource OblivionTextMuted}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Packer detection -->
        <Border Padding="14,10" Margin="0,0,0,8">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CyberpunkCard}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedFile.DetectedPacker}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border CornerRadius="4" Padding="8,4" Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource OblivionOrangeBg}"
                        BorderBrush="{DynamicResource OblivionOrange}" BorderThickness="1">
                    <TextBlock Text="PACKED" FontSize="10" FontWeight="Bold"
                               FontFamily="{StaticResource OblivionMonoFont}"
                               Foreground="{DynamicResource OblivionOrange}"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="13" FontWeight="SemiBold"
                               FontFamily="{StaticResource OblivionMonoFont}"
                               Foreground="{DynamicResource OblivionText}"
                               Text="{Binding SelectedFile.DetectedPacker}"/>
                    <TextBlock Text="Packer/protector detected by signature analysis"
                               FontSize="10" Foreground="{DynamicResource OblivionTextMuted}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Overlay detection -->
        <Border Padding="14,10" Margin="0,0,0,8">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CyberpunkCard}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedFile.HasOverlay}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border CornerRadius="4" Padding="8,4" Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource OblivionCard}"
                        BorderBrush="{DynamicResource OblivionAccent}" BorderThickness="1">
                    <TextBlock Text="OVERLAY" FontSize="10" FontWeight="Bold"
                               FontFamily="{StaticResource OblivionMonoFont}"
                               Foreground="{DynamicResource OblivionAccent}"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="13" FontWeight="SemiBold"
                               FontFamily="{StaticResource OblivionMonoFont}"
                               Foreground="{DynamicResource OblivionText}">
                        <Run Text="{Binding SelectedFile.OverlaySize, Converter={StaticResource SmartFileSizeConverter}, Mode=OneWay}"/>
                        <Run Text="appended data" FontWeight="Normal" FontSize="11"
                             Foreground="{DynamicResource OblivionTextMuted}"/>
                    </TextBlock>
                    <TextBlock FontSize="10" Foreground="{DynamicResource OblivionTextMuted}"
                               FontFamily="{StaticResource OblivionMonoFont}">
                        <Run Text="Offset 0x"/><!--
                     --><Run Text="{Binding SelectedFile.OverlayOffset, StringFormat='{}{0:X}', Mode=OneWay}"
                              Foreground="{DynamicResource OblivionAccent}"/>
                    </TextBlock>
                </StackPanel>

                <ui:Button Grid.Column="2" Appearance="Transparent"
                           Command="{Binding ExtractOverlayCommand}"
                           VerticalAlignment="Center" Padding="8,4"
                           ToolTip="Extract overlay to file">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14"
                                       Foreground="{DynamicResource OblivionAccent}"/>
                        <TextBlock Text="Extract" FontSize="11" Margin="4,0,0,0"
                                   FontFamily="{StaticResource OblivionMonoFont}"
                                   Foreground="{DynamicResource OblivionAccent}"/>
                    </StackPanel>
                </ui:Button>
            </Grid>
        </Border>

        <!-- Anomaly list -->
        <Border Padding="12,8" MaxHeight="180">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CyberpunkCard}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedFile.AnomalyCount}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="ANOMALIES" FontSize="10" FontWeight="SemiBold"
                           FontFamily="{StaticResource OblivionMonoFont}"
                          
                           Foreground="{DynamicResource OblivionTextMuted}" Margin="4,0,0,6"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="140">
                    <ItemsControl ItemsSource="{Binding SelectedFile.Anomalies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:PEAnomaly}">
                                <Border Margin="0,0,0,4" Padding="8,5" CornerRadius="4"
                                        Background="{Binding Severity, Converter={StaticResource SeverityToBackgroundConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Severity badge -->
                                        <Border CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Background="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}">
                                            <TextBlock Text="{Binding Severity}" FontSize="9" FontWeight="Bold"
                                                       FontFamily="{StaticResource OblivionMonoFont}"
                                                       Foreground="White"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="12"
                                                       Foreground="{DynamicResource OblivionText}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" FontSize="10"
                                                       Foreground="{DynamicResource OblivionTextMuted}"
                                                       TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Clean state -->
        <Border Padding="16,12">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CyberpunkCard}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedFile.AnomalyCount}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="16"
                               Foreground="{DynamicResource OblivionGreen}" Margin="0,0,8,0">
                    <ui:SymbolIcon.Effect>
                        <DropShadowEffect Color="#00ff88" BlurRadius="8"
                                          ShadowDepth="0" Opacity="0.3"/>
                    </ui:SymbolIcon.Effect>
                </ui:SymbolIcon>
                <TextBlock Text="No anomalies detected" FontSize="12"
                           FontFamily="{StaticResource OblivionMonoFont}"
                           Foreground="{DynamicResource OblivionGreen}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
