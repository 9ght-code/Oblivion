<UserControl x:Class="Oblivion.GUI.Widgets.EmptyStateWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Oblivion.GUI.Widgets"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Style="{StaticResource FadeInOnLoad}">

            <ui:SymbolIcon Symbol="DocumentSearch24" FontSize="64"
                           Foreground="{DynamicResource OblivionAccent}"
                           HorizontalAlignment="Center" Margin="0,0,0,24"
                           Opacity="0.4">
                <ui:SymbolIcon.Effect>
                    <DropShadowEffect Color="#00f0ff" BlurRadius="20"
                                      ShadowDepth="0" Opacity="0.3"/>
                </ui:SymbolIcon.Effect>
            </ui:SymbolIcon>

            <TextBlock Text="NO FILE SELECTED"
                       FontSize="18" FontWeight="Bold"
                       FontFamily="{StaticResource OblivionMonoFont}"
                       Foreground="{DynamicResource OblivionTextSecondary}"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Select a file from the explorer to view details"
                       FontSize="12"
                       FontFamily="{StaticResource OblivionMonoFont}"
                       Foreground="{DynamicResource OblivionTextMuted}"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>

            <!-- Terminal cursor blink -->
            <Border Width="8" Height="2" Margin="0,16,0,0"
                    Background="{DynamicResource OblivionAccent}"
                    HorizontalAlignment="Center"
                    Style="{StaticResource PulsingGlow}"/>
        </StackPanel>
    </Grid>
</UserControl>
