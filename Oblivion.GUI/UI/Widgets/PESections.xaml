<UserControl x:Class="Oblivion.GUI.Widgets.PESections"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Oblivion.GUI.Widgets"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <DockPanel Style="{StaticResource FadeInOnLoad}">
        <TextBlock Text="PE SECTIONS" DockPanel.Dock="Top"
                   Foreground="{DynamicResource OblivionTextMuted}"
                   FontWeight="SemiBold" FontSize="11"
                   FontFamily="{StaticResource OblivionMonoFont}"
                   Margin="0,0,0,8"/>

        <Border Background="{DynamicResource OblivionSurface}"
                BorderBrush="{DynamicResource OblivionBorder}"
                BorderThickness="1" CornerRadius="6" ClipToBounds="True">

            <ui:DataGrid ItemsSource="{Binding SelectedFile.Sections}"
                         Background="Transparent" BorderThickness="0"
                         AutoGenerateColumns="False" HeadersVisibility="Column"
                         GridLinesVisibility="Horizontal"
                         RowBackground="Transparent"
                         AlternatingRowBackground="{DynamicResource OblivionCard}"
                         Foreground="{DynamicResource OblivionText}"
                         IsReadOnly="True">

                <ui:DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource OblivionCard}"/>
                        <Setter Property="Foreground" Value="{DynamicResource OblivionAccent}"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontFamily" Value="{StaticResource OblivionMonoFont}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource OblivionBorder}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </ui:DataGrid.ColumnHeaderStyle>

                <ui:DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="{DynamicResource OblivionText}"/>
                        <Setter Property="FontFamily" Value="{StaticResource OblivionMonoFont}"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ui:DataGrid.CellStyle>

                <ui:DataGrid.Columns>
                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource OblivionAccent}"/>
                                <Setter Property="FontFamily" Value="{StaticResource OblivionMonoFont}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="RAW SIZE" Binding="{Binding RawDataSize}" Width="*"/>
                    <DataGridTextColumn Header="V. SIZE" Binding="{Binding VirtualSize}" Width="*"/>

                    <DataGridTemplateColumn Header="ACCESS" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- R badge -->
                                    <Border Background="{Binding IsReadable, Converter={StaticResource BoolToPermissionBrushConverter}, ConverterParameter='R'}"
                                            CornerRadius="4" Width="22" Height="22" Margin="2,0">
                                        <TextBlock Text="R" FontSize="10" FontWeight="Bold"
                                                   FontFamily="{StaticResource OblivionMonoFont}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReadable}" Value="False">
                                                            <Setter Property="Opacity" Value="0.2"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource OblivionTextMuted}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- W badge -->
                                    <Border Background="{Binding IsWritable, Converter={StaticResource BoolToPermissionBrushConverter}, ConverterParameter='W'}"
                                            CornerRadius="4" Width="22" Height="22" Margin="2,0">
                                        <TextBlock Text="W" FontSize="10" FontWeight="Bold"
                                                   FontFamily="{StaticResource OblivionMonoFont}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWritable}" Value="False">
                                                            <Setter Property="Opacity" Value="0.2"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource OblivionTextMuted}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- X badge -->
                                    <Border Background="{Binding IsExecutable, Converter={StaticResource BoolToPermissionBrushConverter}, ConverterParameter='X'}"
                                            CornerRadius="4" Width="22" Height="22" Margin="2,0">
                                        <TextBlock Text="X" FontSize="10" FontWeight="Bold"
                                                   FontFamily="{StaticResource OblivionMonoFont}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExecutable}" Value="False">
                                                            <Setter Property="Opacity" Value="0.2"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource OblivionTextMuted}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </ui:DataGrid.Columns>

            </ui:DataGrid>
        </Border>
    </DockPanel>
</UserControl>
