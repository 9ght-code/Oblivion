<UserControl x:Class="Oblivion.GUI.Widgets.ImportedLibraries"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Oblivion.GUI.Widgets"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Style="{StaticResource FadeInOnLoad}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="IMPORTED LIBRARIES"
                   Foreground="{DynamicResource OblivionTextMuted}"
                   FontWeight="SemiBold" FontSize="11"
                   FontFamily="{StaticResource OblivionMonoFont}"
                   Margin="0,0,0,8"/>

        <Border Grid.Row="1" Style="{StaticResource CyberpunkCard}" Padding="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SelectedFile.Imports}" Padding="4"
                              HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel HorizontalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Margin="0,1" HorizontalAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Library24" FontSize="13"
                                                       Foreground="{DynamicResource OblivionAccent}"
                                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ModuleName}"
                                                   Foreground="{DynamicResource OblivionAccent}"
                                                   FontFamily="{StaticResource OblivionMonoFont}" FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="{DynamicResource OblivionCardHover}"
                                                BorderBrush="{DynamicResource OblivionBorder}"
                                                BorderThickness="1"
                                                CornerRadius="4" Margin="8,0,0,0" Padding="5,1">
                                            <TextBlock Text="{Binding Functions.Count}"
                                                       Foreground="{DynamicResource OblivionAccent}"
                                                       FontFamily="{StaticResource OblivionMonoFont}"
                                                       FontSize="10"/>
                                        </Border>
                                    </StackPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Functions}" Margin="24,2,0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{DynamicResource OblivionTextSecondary}"
                                                       FontFamily="{StaticResource OblivionMonoFont}" FontSize="11"
                                                       Margin="0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
