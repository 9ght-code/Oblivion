<UserControl x:Class="Oblivion.GUI.Widgets.BadgeInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Oblivion.GUI.Widgets"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UniformGrid Columns="3" Margin="0,0,0,16">
        <!-- Architecture -->
        <Border Style="{StaticResource CyberpunkCardAnimated}"
                Padding="16,12" Margin="0,0,8,0">
            <StackPanel>
                <TextBlock Text="ARCHITECTURE" Foreground="{DynamicResource OblivionTextMuted}"
                           FontSize="10" FontFamily="{StaticResource OblivionMonoFont}"
                           Margin="0,0,0,6"/>
                <TextBlock Text="{Binding SelectedFile.Architecture}"
                           Foreground="{DynamicResource OblivionText}"
                           FontWeight="Bold" FontSize="16"
                           FontFamily="{StaticResource OblivionMonoFont}"/>
            </StackPanel>
        </Border>

        <!-- File Size -->
        <Border Style="{StaticResource CyberpunkCardAnimated}"
                Padding="16,12" Margin="4,0">
            <StackPanel>
                <TextBlock Text="FILE SIZE" Foreground="{DynamicResource OblivionTextMuted}"
                           FontSize="10" FontFamily="{StaticResource OblivionMonoFont}"
                           Margin="0,0,0,6"/>
                <TextBlock Text="{Binding SelectedFile.FileSize, Converter={StaticResource SmartFileSizeConverter}}"
                           Foreground="{DynamicResource OblivionText}"
                           FontWeight="Bold" FontSize="16"
                           FontFamily="{StaticResource OblivionMonoFont}"/>
            </StackPanel>
        </Border>

        <!-- Entry Point -->
        <Border Style="{StaticResource CyberpunkCardAnimated}"
                Padding="16,12" Margin="8,0,0,0">
            <StackPanel>
                <TextBlock Text="ENTRY POINT" Foreground="{DynamicResource OblivionTextMuted}"
                           FontSize="10" FontFamily="{StaticResource OblivionMonoFont}"
                           Margin="0,0,0,6"/>
                <TextBlock Text="{Binding SelectedFile.EntryPoint}"
                           Foreground="{DynamicResource OblivionAccent}"
                           FontWeight="Bold" FontSize="16"
                           FontFamily="{StaticResource OblivionMonoFont}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00f0ff" BlurRadius="6"
                                          ShadowDepth="0" Opacity="0.2"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>
        </Border>
    </UniformGrid>
</UserControl>
