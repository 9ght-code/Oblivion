<UserControl x:Class="Oblivion.GUI.MVVM.View.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:widgets="clr-namespace:Oblivion.GUI.Widgets"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:ext="clr-namespace:Oblivion.GUI.Domain.Extensions"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Background="{DynamicResource OblivionBg}" Margin="24,16">

        <!-- Empty state -->
        <widgets:EmptyStateWidget>
            <widgets:EmptyStateWidget.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedFile}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </widgets:EmptyStateWidget.Style>
        </widgets:EmptyStateWidget>

        <!-- File details -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedFile}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel>
                <widgets:FileHeaderWidget DataContext="{Binding}"/>
                <widgets:HealthCheckWidget DataContext="{Binding}"/>
                <widgets:BadgeInfo DataContext="{Binding}"/>

                <Grid MinHeight="200">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <widgets:PESections DataContext="{Binding}"/>
                    <widgets:ImportedLibraries Grid.Column="2" DataContext="{Binding}"/>
                </Grid>

                <widgets:Entropy DataContext="{Binding}" MinHeight="120" Margin="0,8,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <ui:Button Content="Analyze" Appearance="Primary" Icon="{ui:SymbolIcon Play24}"
                               Width="120" Height="34" Margin="0,0,10,0" Command="{Binding AnalyzeCommand}">
                        <i:Interaction.Behaviors>
                            <ext:ButtonScaleBehavior/>
                        </i:Interaction.Behaviors>
                    </ui:Button>
                    <ui:Button Content="Export" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowExportLtr24}"
                               Width="120" Height="34" Command="{Binding ExportCommand}">
                        <i:Interaction.Behaviors>
                            <ext:ButtonScaleBehavior/>
                        </i:Interaction.Behaviors>
                    </ui:Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
