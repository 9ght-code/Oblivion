<UserControl x:Class="Oblivion.GUI.MVVM.View.AnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:widgets="clr-namespace:Oblivion.GUI.UI.AnalysisWidgets"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:ext="clr-namespace:Oblivion.GUI.Domain.Extensions"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Style="{StaticResource FadeIn}">

    <Grid Background="{DynamicResource OblivionBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- File Header Bar -->
        <Border Grid.Row="0" Background="{DynamicResource OblivionCard}"
                Padding="20,12">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,1">
                    <GradientStop Color="#00f0ff" Offset="0"/>
                    <GradientStop Color="#1e293b" Offset="0.3"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>
                <Thickness Bottom="1"/>
            </Border.BorderThickness>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Back button -->
                <ui:Button Grid.Column="0" Appearance="Transparent" Padding="6"
                           Margin="0,0,12,0" VerticalAlignment="Center"
                           Command="{Binding DataContext.BackToHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                           ToolTip="Back to files">
                    <i:Interaction.Behaviors>
                        <ext:ButtonScaleBehavior/>
                    </i:Interaction.Behaviors>
                    <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="18"
                                   Foreground="{DynamicResource OblivionTextSecondary}"/>
                </ui:Button>

                <!-- File icon with glow -->
                <Border Grid.Column="1" Background="{DynamicResource OblivionSurface}"
                        BorderBrush="{DynamicResource OblivionAccent}" BorderThickness="1"
                        CornerRadius="8" Width="40" Height="40" Margin="0,0,14,0">
                    <ui:SymbolIcon Symbol="Document24" FontSize="20"
                                   Foreground="{DynamicResource OblivionAccent}">
                        <ui:SymbolIcon.Effect>
                            <DropShadowEffect Color="#00f0ff" BlurRadius="8"
                                              ShadowDepth="0" Opacity="0.3"/>
                        </ui:SymbolIcon.Effect>
                    </ui:SymbolIcon>
                </Border>

                <!-- File info -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="Bold"
                                   FontFamily="{StaticResource OblivionMonoFont}"
                                   Foreground="{DynamicResource OblivionText}" Margin="0,0,14,0"/>

                        <Border Background="{DynamicResource OblivionSurface}"
                                BorderBrush="{DynamicResource OblivionBorder}" BorderThickness="1"
                                CornerRadius="4" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Architecture}" FontSize="11"
                                       FontFamily="{StaticResource OblivionMonoFont}"
                                       Foreground="{DynamicResource OblivionAccent}"/>
                        </Border>

                        <Border Background="{DynamicResource OblivionSurface}"
                                BorderBrush="{DynamicResource OblivionBorder}" BorderThickness="1"
                                CornerRadius="4" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock FontSize="11" FontFamily="{StaticResource OblivionMonoFont}"
                                       Foreground="{DynamicResource OblivionTextSecondary}">
                                <Run Text="Size: "/><Run Text="{Binding FileSize, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>

                        <Border Background="{DynamicResource OblivionSurface}"
                                BorderBrush="{DynamicResource OblivionBorder}" BorderThickness="1"
                                CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock FontSize="11" FontFamily="{StaticResource OblivionMonoFont}"
                                       Foreground="{DynamicResource OblivionAccent}">
                                <Run Text="EP: " Foreground="{DynamicResource OblivionTextSecondary}"/>
                                <Run Text="{Binding EntryPoint, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <TextBlock FontSize="10" FontFamily="{StaticResource OblivionMonoFont}" Margin="0,3,0,0"
                               Foreground="{DynamicResource OblivionTextMuted}">
                        <Run Text="SHA256: "/><Run Text="{Binding Hash, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading overlay with shimmer skeleton -->
        <Border Grid.Row="1" Panel.ZIndex="10"
                Background="{DynamicResource OblivionBg}"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Shimmer skeleton bars -->
                <StackPanel Grid.Row="0">
                    <Border Style="{StaticResource ShimmerLoading}" Height="18" Width="260"
                            HorizontalAlignment="Left" Margin="0,0,0,12"/>
                    <Border Style="{StaticResource ShimmerLoading}" Height="12" Width="400"
                            HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource ShimmerLoading}" Height="12" Width="340"
                            HorizontalAlignment="Left" Margin="0,0,0,16"/>
                    <Border Style="{StaticResource ShimmerLoading}" Height="80"
                            HorizontalAlignment="Stretch" Margin="0,0,0,12"/>
                    <Border Style="{StaticResource ShimmerLoading}" Height="80"
                            HorizontalAlignment="Stretch" Margin="0,0,0,12"/>
                </StackPanel>

                <!-- Centered spinner + label -->
                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48"
                                     Foreground="{DynamicResource OblivionAccent}">
                        <ui:ProgressRing.Effect>
                            <DropShadowEffect Color="#00f0ff" BlurRadius="20"
                                              ShadowDepth="0" Opacity="0.4"/>
                        </ui:ProgressRing.Effect>
                    </ui:ProgressRing>
                    <TextBlock Text="LOADING ANALYSIS..." FontSize="11" Margin="0,14,0,0"
                               FontFamily="{StaticResource OblivionMonoFont}"
                               Foreground="{DynamicResource OblivionAccent}"
                               HorizontalAlignment="Center"
                               Style="{StaticResource PulsingGlow}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TabControl with neon underline tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0"
                    Padding="0"
                    SelectedIndex="{Binding ActiveTabIndex, Mode=TwoWay}">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource OblivionTextMuted}"/>
                    <Setter Property="Padding" Value="14,8"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontFamily" Value="{StaticResource OblivionMonoFont}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="Transparent"
                                        Padding="{TemplateBinding Padding}"
                                        BorderThickness="0,0,0,2"
                                        BorderBrush="Transparent"
                                        Cursor="Hand">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="BorderBrush"
                                                Value="{DynamicResource OblivionAccent}"/>
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource OblivionAccent}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background"
                                                Value="{DynamicResource OblivionCardHover}"/>
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource OblivionTextSecondary}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Overview">
                <widgets:OverviewTab DataContext="{Binding}"/>
            </TabItem>
            <TabItem Header="Sections">
                <widgets:SectionsTab DataContext="{Binding}"/>
            </TabItem>
            <TabItem Header="Hex Editor">
                <widgets:HexEditorTab DataContext="{Binding}"/>
            </TabItem>
            <TabItem Header="Imports">
                <widgets:ImportsTab DataContext="{Binding}"/>
            </TabItem>
            <TabItem Header="Entry Point">
                <widgets:EntryPointTab DataContext="{Binding}"/>
            </TabItem>
            <TabItem Header="Disassembler">
                <widgets:DisassemblerTab DataContext="{Binding}"/>
            </TabItem>
            <TabItem Header="Strings">
                <widgets:StringsTab DataContext="{Binding StringsTab}"/>
            </TabItem>
            <TabItem Header="Security">
                <widgets:SecurityTab DataContext="{Binding}"/>
            </TabItem>
            <TabItem Header="Functions DB">
                <widgets:FunctionsDbTab DataContext="{Binding FunctionsDbTab}"/>
            </TabItem>
            <TabItem Header="Shellcode">
                <widgets:ShellcodeTab DataContext="{Binding}"/>
            </TabItem>
            <TabItem Header="Tools">
                <widgets:ToolsTab DataContext="{Binding ToolsTab}"/>
            </TabItem>
        </TabControl>
    </Grid>

</UserControl>
